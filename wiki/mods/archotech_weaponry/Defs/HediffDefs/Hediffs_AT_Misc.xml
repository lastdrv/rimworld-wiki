<Defs> <!-- Корневой контейнер описаний (Defs) -->

  <HediffDef ParentName="DiseaseBase"> <!-- Определение состояния/заболевания пешки (Hediff) -->
    <defName>VoidToxin</defName> <!-- Уникальный идентификатор определения (Def) -->
    <label>void toxin</label> <!-- Отображаемое наименование -->
    <description>A powerful neurotoxin made out of small mechanites. Slowly neutralizing the body.</description> <!-- Текстовое описание предмета или эффекта -->
    <hediffClass>HediffWithComps</hediffClass> <!-- C#-класс обработки Hediff -->
    <makesSickThought>true</makesSickThought> <!-- Флаг вызова мыслей о болезни у пешки -->
    <minSeverity>0</minSeverity> <!-- Минимальная тяжесть состояния -->
    <initialSeverity>0.01</initialSeverity> <!-- Начальная тяжесть состояния при наложении -->
    <stages> <!-- Список стадий развития заболевания/состояния -->
      <li> <!-- Элемент списка -->
        <label>stage 1</label> <!-- Отображаемое наименование -->
        <capMods> <!-- Модификаторы способностей/возможностей пешки -->
          <li> <!-- Элемент списка -->
            <capacity>Manipulation</capacity> <!-- Целевая способность пешки (Движение, Работа и т.д.) -->
            <offset>-0.1</offset> <!-- Смещение/изменение значения характеристики -->
          </li>
        </capMods>
      </li>
      <li> <!-- Элемент списка -->
        <minSeverity>0.25</minSeverity> <!-- Минимальная тяжесть состояния -->
        <label>stage 2</label> <!-- Отображаемое наименование -->
        <capMods> <!-- Модификаторы способностей/возможностей пешки -->
          <li> <!-- Элемент списка -->
            <capacity>Manipulation</capacity> <!-- Целевая способность пешки (Движение, Работа и т.д.) -->
            <offset>-0.1</offset> <!-- Смещение/изменение значения характеристики -->
          </li>
          <li> <!-- Элемент списка -->
            <capacity>Moving</capacity> <!-- Целевая способность пешки (Движение, Работа и т.д.) -->
            <offset>-0.1</offset> <!-- Смещение/изменение значения характеристики -->
          </li>
        </capMods>
      </li>
      <li> <!-- Элемент списка -->
        <minSeverity>0.40</minSeverity> <!-- Минимальная тяжесть состояния -->
        <label>stage 3</label> <!-- Отображаемое наименование -->
        <capMods> <!-- Модификаторы способностей/возможностей пешки -->
          <li> <!-- Элемент списка -->
            <capacity>Manipulation</capacity> <!-- Целевая способность пешки (Движение, Работа и т.д.) -->
            <offset>-0.3</offset> <!-- Смещение/изменение значения характеристики -->
          </li>
          <li> <!-- Элемент списка -->
            <capacity>Moving</capacity> <!-- Целевая способность пешки (Движение, Работа и т.д.) -->
            <offset>-0.3</offset> <!-- Смещение/изменение значения характеристики -->
          </li>
        </capMods>
      </li>
      <li> <!-- Элемент списка -->
        <minSeverity>1</minSeverity> <!-- Минимальная тяжесть состояния -->
        <label>stage 4</label> <!-- Отображаемое наименование -->
        <capMods> <!-- Модификаторы способностей/возможностей пешки -->

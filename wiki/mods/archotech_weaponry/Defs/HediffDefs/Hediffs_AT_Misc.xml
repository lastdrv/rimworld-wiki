          <li> <!-- Элемент списка -->
            <capacity>Moving</capacity> <!-- Целевая способность пешки (Движение, Работа и т.д.) -->
            <offset>-1</offset> <!-- Смещение/изменение значения характеристики -->
          </li>
        </capMods>
      </li>
    </stages>
    <comps> <!-- Список C#-компонентов объекта -->
      <li Class="HediffCompProperties_Disappears"> <!-- Компонент автоматического исчезновения состояния со временем -->
        <disappearsAfterTicks>60000</disappearsAfterTicks> <!-- 1 day -->
      </li>
    </comps>
  </HediffDef>


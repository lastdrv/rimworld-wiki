      <wornGraphicPath>Things/Apparel/Headgear/Balaclava_Ghost</wornGraphicPath> <!-- Путь к текстуре надетого элемента экипировки -->
      <!--<hatRenderedFrontOfFace>true</hatRenderedFrontOfFace>-->

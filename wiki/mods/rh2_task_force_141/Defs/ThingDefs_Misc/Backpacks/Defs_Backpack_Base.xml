<?xml version="1.0" encoding="utf-8" ?>
<Defs> <!-- Корневой контейнер описательных структур (Defs) RimWorld -->

	<!-- RH2 Backpack Base -->

  <ThingDef Name="RH2_BackpackBase" ParentName="ApparelBase" Abstract="True"> <!-- Определение сущности/предмета в игре (ThingDef) -->
	<techLevel>Industrial</techLevel>  <!-- Технологический уровень -->
	<tradeability>All</tradeability> <!-- Доступность предмета для торговли (All, SellableByPlayer и т.д.) -->
	<resourceReadoutPriority>Middle</resourceReadoutPriority> <!-- Приоритет отображения на панели ресурсов -->
	
	<recipeMaker> <!-- Генератор рецепта для изготовления предмета -->
      <researchPrerequisite>ComplexClothing</researchPrerequisite> <!-- Необходимый исследовательский проект -->
    </recipeMaker>
	
	<graphicData> <!-- Параметры графического отображения -->
      <graphicClass>Graphic_Single</graphicClass>	 <!-- C#-класс отрисовки графики -->
    </graphicData>		
    <apparel> <!-- Параметры предмета одежды/снаряжения -->
	<countsAsClothingForNudity>false</countsAsClothingForNudity> <!-- Считается ли предмет одеждой для предотвращения наготы -->
      <wornGraphicData> <!-- Параметры графики надетой экипировки по направлениям -->
        <renderUtilityAsPack>true</renderUtilityAsPack>	 <!-- Отрисовка служебного снаряжения как рюкзака -->
      </wornGraphicData>
      <careIfWornByCorpse>false</careIfWornByCorpse> <!-- Учет штрафа к настроению за снятие с трупа ('одежда мертвеца') -->
      <careIfDamaged>false</careIfDamaged> <!-- Учет штрафа за износ одежды -->
      <wearPerDay>0</wearPerDay> <!-- Скорость естественного износа за день ношения -->
      <bodyPartGroups> <!-- Защищаемые/покрываемые группы частей тела -->
        <li>Shoulders</li> <!-- Элемент списка -->
      </bodyPartGroups>
      <layers> <!-- Слои ношения экипировки -->
        <li>Belt</li> <!-- Элемент списка -->
      </layers>
      <tags> <!-- Теги классификации предмета -->
        <li>RH2_Backpack</li> <!-- Элемент списка -->
      </tags>
	  <defaultOutfitTags> <!-- Теги назначения одежды в стандартных наборах поселения -->
		<li>Soldier</li> <!-- Элемент списка -->
	  </defaultOutfitTags>
	  <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth> <!-- Возможность генерации для защиты от холода -->
    </apparel>
    <tradeTags> <!-- Торговые теги предмета -->
      <li>RH2_Backpack</li> <!-- Элемент списка -->
    </tradeTags>
    <thingCategories> <!-- Категории складирования предметов -->
      <li>RNApparel_Belts</li> <!-- Элемент списка -->
    </thingCategories>	
  </ThingDef>	
  
  

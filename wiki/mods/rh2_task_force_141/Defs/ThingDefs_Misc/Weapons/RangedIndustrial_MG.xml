<?xml version="1.0" encoding="utf-8" ?>
<Defs> <!-- Корневой контейнер описательных структур (Defs) RimWorld -->

  <!-- ================================= LMG ==================================== -->
  
      <!-- ================================= FN Minimi ==================================== -->
  
	<ThingDef ParentName="BaseHumanMakeableGun"> <!-- Определение сущности/предмета в игре (ThingDef) -->
		<defName>RNGun_FNMinimi762MG</defName> <!-- Уникальный идентификатор определения (Def) -->
		<label>FN Minimi 7.62</label> <!-- Отображаемое наименование -->
		<description>The FN Minimi (short for French: Mini Mitrailleuse; "mini machine gun") is a Belgian 5.56mm Squad Automatic Weapon, or SAW developed by Fabrique Nationale (FN) in Herstal by Ernest Vervier. First introduced in the late 1970s, it is now in service in more than 75 countries.n/n/This version is chambered in 7.62x51mm NATO.</description> <!-- Текстовое описание предмета, сущности или механики -->
		<graphicData> <!-- Параметры графического отображения -->
			<texPath>Things/Weapons/FN_Minimi762</texPath> <!-- Путь к текстуре в ресурсах мода -->
			<graphicClass>Graphic_Single</graphicClass> <!-- C#-класс отрисовки графики -->
		</graphicData>
		<soundInteract>Interact_Rifle</soundInteract> <!-- Звук взаимодействия/перезарядки -->
    <recipeMaker> <!-- Генератор рецепта для изготовления предмета -->
      <researchPrerequisite>GasOperation</researchPrerequisite> <!-- Необходимый исследовательский проект -->
      <skillRequirements> <!-- Минимальные требования к навыкам для создания -->
        <Crafting>6</Crafting> <!-- Навык: Ремесло -->
      </skillRequirements>
    </recipeMaker>
		<statBases> <!-- Базовые числовые характеристики -->
			<WorkToMake>32000</WorkToMake> <!-- Трудозатраты на изготовление (в тиках работы) -->
			<Mass>6</Mass> <!-- Масса предмета в килограммах -->
			<AccuracyTouch>0.53</AccuracyTouch> <!-- Меткость стрельбы в упор (до 3 клеток) -->
			<AccuracyShort>0.63</AccuracyShort> <!-- Меткость стрельбы на короткой дистанции (до 12 клеток) -->
			<AccuracyMedium>0.38</AccuracyMedium> <!-- Меткость стрельбы на средней дистанции (до 25 клеток) -->
			<AccuracyLong>0.27</AccuracyLong> <!-- Меткость стрельбы на дальней дистанции (до 40 клеток) -->
			<RangedWeapon_Cooldown>1.2</RangedWeapon_Cooldown> <!-- Время перезарядки/восстановления оружия -->
		</statBases>
		<costList> <!-- Фиксированный список затрачиваемых материалов -->
			<Steel>60</Steel> <!-- Ресурс: Сталь -->
			<ComponentIndustrial>3</ComponentIndustrial> <!-- Ресурс: Компонент -->
		</costList>
		
				<equippedAngleOffset>40</equippedAngleOffset> <!-- Угловое смещение оружия в руках пешки -->
		
    <verbs> <!-- Список боевых действий/режимов атаки -->
			<li> <!-- Элемент списка -->
				<verbClass>Verb_Shoot</verbClass> <!-- C#-класс боевого действия (Verb_Shoot и др.) -->
				<hasStandardCommand>true</hasStandardCommand> <!-- Флаг наличия стандартной кнопки атаки -->
				<defaultProjectile>RNBullet_762x51mm_LMG</defaultProjectile> <!-- Снаряд по умолчанию для оружия -->
				<warmupTime>1.5</warmupTime> <!-- Время подготовки к выстрелу/атаке (сек.) -->
				<range>25.5</range> <!-- Максимальная дальность стрельбы (клеток) -->
				<ticksBetweenBurstShots>7</ticksBetweenBurstShots> <!-- Интервал между выстрелами в очереди (тики) -->
				<burstShotCount>8</burstShotCount> <!-- Количество выстрелов в очереди -->
				<soundCast>RNShot_GenericDMR_II</soundCast> <!-- Звук основного выстрела -->
				<soundCastTail>GunTail_Medium</soundCastTail> <!-- Звук затухания/эха выстрела -->
				<muzzleFlashScale>9</muzzleFlashScale> <!-- Масштаб вспышки от выстрела -->
			</li>
		</verbs>
		<weaponTags> <!-- Теги оружия для генерации пешкам и фракциям -->
			<!--<li>IndustrialGunAdvanced</li>-->
			<li>RH2_Coalition_MG</li> <!-- Элемент списка -->
			<li>RNGun_FNMinimi762</li> <!-- Элемент списка -->
		</weaponTags>
    <tools> <!-- Список рукопашных атак/инструментов оружия -->
      <li> <!-- Элемент списка -->
        <label>stock</label> <!-- Отображаемое наименование -->
        <capacities> <!-- Виды урона при атаке -->
          <li>Blunt</li> <!-- Элемент списка -->
        </capacities>
        <power>9</power> <!-- Сила рукопашного удара -->
        <cooldownTime>2</cooldownTime> <!-- Время перезарядки рукопашного удара (сек.) -->
      </li>
      <li> <!-- Элемент списка -->
        <label>barrel</label> <!-- Отображаемое наименование -->
        <capacities> <!-- Виды урона при атаке -->
          <li>Blunt</li> <!-- Элемент списка -->
          <li>Poke</li> <!-- Элемент списка -->
        </capacities>
        <power>9</power> <!-- Сила рукопашного удара -->
        <cooldownTime>2</cooldownTime> <!-- Время перезарядки рукопашного удара (сек.) -->
      </li>
    </tools>
  </ThingDef>
</Defs>

<Defs> <!-- Корневой контейнер описательных структур (Defs) RimWorld -->

  <!-- ================================= SHARPSHOOTAH ==================================== -->
  
  		 <!-- ================================= L129A1 ==================================== -->

  <ThingDef ParentName="BaseHumanMakeableGun"> <!-- Определение сущности/предмета в игре (ThingDef) -->
    <defName>RNGun_RSASS_DMR</defName> <!-- Уникальный идентификатор определения (Def) -->
    <label>RSASS</label> <!-- Отображаемое наименование -->
    <description> <!-- Текстовое описание предмета, сущности или механики -->The Remington Semi Automatic Sniper System (RSASS) is a semi-automatic precision rifle manufactured by Remington Arms.

The rifle is based on the Stoner AR-10 system adapted to .308 caliber cartridges, with adjustable direct gas impingement operation and rotary bolt locking. The receiver is designed with a folding charging handle located on the left side, which facilitates more comfortable operation from prone position. The barrel is made from stainless steel for maximum accuracy and fitted with a flash hider (when a suppressor is not used). Additional features include a fully adjustable Magpul stock and a flat-top style upper receiver with integral Picatinny rail. The rifle is fed using SR-25 pattern .308/7.62 magazines with 19- or 20-round capacities.</description>
    <graphicData> <!-- Параметры графического отображения -->
      <texPath>Things/Weapons/RSASS</texPath> <!-- Путь к текстуре в ресурсах мода -->
      <graphicClass>Graphic_Single</graphicClass> <!-- C#-класс отрисовки графики -->
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract> <!-- Звук взаимодействия/перезарядки -->
	<equippedAngleOffset>40</equippedAngleOffset> <!-- Угловое смещение оружия в руках пешки -->
    <statBases> <!-- Базовые числовые характеристики -->
      <WorkToMake>42000</WorkToMake> <!-- Трудозатраты на изготовление (в тиках работы) -->
      <Mass>3.5</Mass> <!-- Масса предмета в килограммах -->
      <AccuracyTouch>0.56</AccuracyTouch> <!-- Меткость стрельбы в упор (до 3 клеток) -->
      <AccuracyShort>0.68</AccuracyShort> <!-- Меткость стрельбы на короткой дистанции (до 12 клеток) -->
      <AccuracyMedium>0.93</AccuracyMedium> <!-- Меткость стрельбы на средней дистанции (до 25 клеток) -->
      <AccuracyLong>0.90</AccuracyLong> <!-- Меткость стрельбы на дальней дистанции (до 40 клеток) -->
      <RangedWeapon_Cooldown>1.3</RangedWeapon_Cooldown> <!-- Время перезарядки/восстановления оружия -->
    </statBases>
    <costList> <!-- Фиксированный список затрачиваемых материалов -->
      <Steel>60</Steel> <!-- Ресурс: Сталь -->
      <ComponentIndustrial>3</ComponentIndustrial> <!-- Ресурс: Компонент -->
    </costList>
    <recipeMaker> <!-- Генератор рецепта для изготовления предмета -->
      <skillRequirements> <!-- Минимальные требования к навыкам для создания -->
        <Crafting>5</Crafting> <!-- Навык: Ремесло -->
      </skillRequirements>
    </recipeMaker>
    <verbs> <!-- Список боевых действий/режимов атаки -->
      <li> <!-- Элемент списка -->
        <verbClass>Verb_Shoot</verbClass> <!-- C#-класс боевого действия (Verb_Shoot и др.) -->
        <hasStandardCommand>true</hasStandardCommand> <!-- Флаг наличия стандартной кнопки атаки -->
        <defaultProjectile>RNBullet_762x51mm_DMR</defaultProjectile> <!-- Снаряд по умолчанию для оружия -->
		<burstShotCount>2</burstShotCount> <!-- Количество выстрелов в очереди -->
        <ticksBetweenBurstShots>55</ticksBetweenBurstShots> <!-- Интервал между выстрелами в очереди (тики) -->
        <warmupTime>1.2</warmupTime> <!-- Время подготовки к выстрелу/атаке (сек.) -->
        <range>45.9</range> <!-- Максимальная дальность стрельбы (клеток) -->
        <soundCast>RNShot_GenericDMR</soundCast> <!-- Звук основного выстрела -->
        <soundCastTail>GunTail_Heavy</soundCastTail> <!-- Звук затухания/эха выстрела -->
        <muzzleFlashScale>9</muzzleFlashScale> <!-- Масштаб вспышки от выстрела -->
      </li>
    </verbs>
    <tools> <!-- Список рукопашных атак/инструментов оружия -->
      <li> <!-- Элемент списка -->
        <label>stock</label> <!-- Отображаемое наименование -->
        <capacities> <!-- Виды урона при атаке -->
          <li>Blunt</li> <!-- Элемент списка -->
        </capacities>
        <power>9</power> <!-- Сила рукопашного удара -->
        <cooldownTime>2</cooldownTime> <!-- Время перезарядки рукопашного удара (сек.) -->
      </li>
      <li> <!-- Элемент списка -->
        <label>barrel</label> <!-- Отображаемое наименование -->
        <capacities> <!-- Виды урона при атаке -->
          <li>Blunt</li> <!-- Элемент списка -->
          <li>Poke</li> <!-- Элемент списка -->
        </capacities>
        <power>9</power> <!-- Сила рукопашного удара -->
        <cooldownTime>2</cooldownTime> <!-- Время перезарядки рукопашного удара (сек.) -->
      </li>
    </tools>
    <weaponTags Inherit="False"> <!-- Теги оружия для генерации пешкам и фракциям -->
      <!--<li>SniperRifle</li>-->
	  <li>RN_Coalition_DMR</li> <!-- Элемент списка -->
	  <li>RN_RSASS</li> <!-- Элемент списка -->
    </weaponTags>
	<tradeTags> <!-- Торговые теги предмета -->
      <li>RN_RSASS</li> <!-- Элемент списка -->
    </tradeTags>
  </ThingDef>
  
          <!-- ================================= THOR M408 AMR ==================================== -->

  <ThingDef ParentName="BaseHumanMakeableGun"> <!-- Определение сущности/предмета в игре (ThingDef) -->
    <defName>RNGun_THORM408AMR</defName> <!-- Уникальный идентификатор определения (Def) -->
    <label>THOR M408</label> <!-- Отображаемое наименование -->
    <description> <!-- Текстовое описание предмета, сущности или механики -->The THOR M408 extreme long range sniper rifle is an evolved version of the original CheyTac M200 sniper system. Developed for extreme range interdiction (ERI), the USA manufactured rifle is produced by THOR Global Defense Group. The M408 system is in use by several law enforcement and military units around the world. The company will not comment or disclose the names or countries of all their clients.
	
The THOR M408 long range sniper rifle is a manually operated, bolt action rifle. It employs traditional rotary bolt with dual frontal locking lugs and fluted body. The massive, extreme duty steel receiver offers strength and accuracy along with a quick-detachable barrel system which facilitates compact storage, simplified maintenance and simple replacement of worn barrels.</description>
    <graphicData> <!-- Параметры графического отображения -->
      <texPath>Things/Weapons/THOR_M408</texPath> <!-- Путь к текстуре в ресурсах мода -->

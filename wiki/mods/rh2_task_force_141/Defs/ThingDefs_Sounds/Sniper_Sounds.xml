<?xml version="1.0" encoding="utf-8"?><Defs>

  	<!-- ===================== DMRs ========================= -->

    	<!-- ===================== DMR_I ========================= -->

  <SoundDef> <!-- Определение звукового эффекта (SoundDef) -->
    <defName>RNShot_GenericDMR</defName>   <!-- Уникальный идентификатор определения (Def) -->
    <context>MapOnly</context> <!-- Контекст воспроизведения звука (Map, Camera и т.д.) -->
    <eventNames /> <!-- Имена игровых событий для воспроизведения звука -->
    <maxSimultaneous>1</maxSimultaneous>   <!-- Максимум одновременных источников звука -->
    <subSounds> <!-- Список подзвуков/аудиодорожек -->
      <li> <!-- Элемент списка -->
        <grains> <!-- Зерна/файлы воспроизведения звука -->
          <li Class="AudioGrain_Clip"> <!-- Элемент списка -->
            <clipPath>Sniper/RNShot_GenericDMR</clipPath> <!-- Путь к аудиофайлу (.wav / .ogg) -->
          </li>
        </grains>
        <volumeRange> <!-- Диапазон громкости звука (дБ) -->
          <min>30</min>         <!-- Минимальное значение -->
          <max>30</max> <!-- Максимальное значение -->
        </volumeRange>    		
        <pitchRange> <!-- Диапазон высоты тона звука -->
          <min>0.936413</min>         <!-- Минимальное значение -->
          <max>1.042391</max> <!-- Максимальное значение -->
        </pitchRange>      
        <paramMappings> <!-- Сопоставление параметров звука -->
          <li> <!-- Элемент списка -->
            <inParam Class="SoundParamSource_CameraAltitude" /> <!-- Входной параметр аудиокривой -->
            <outParam Class="SoundParamTarget_PropertyLowPass"> <!-- Выходной параметр аудиокривой -->
              <filterProperty>Cutoff</filterProperty> <!-- Свойство фильтрации -->
            </outParam>          
            <paramUpdateMode>Constant</paramUpdateMode>           <!-- Режим обновления аудиопараметров -->
            <curve> <!-- Кривая зависимости значений -->
              <points> <!-- Очки стоимости в генераторе групп -->
                <li> <!-- Элемент списка -->
                  <loc> <!-- Локация / источник позиционирования звука -->
                    <x>17.08957</x>                   <!-- Координата X -->
                    <y>21001.8</y> <!-- Координата Y -->
                  </loc>
                </li>              
                <li> <!-- Элемент списка -->
                  <loc> <!-- Локация / источник позиционирования звука -->
                    <x>24.77761</x>                   <!-- Координата X -->
                    <y>12701.95</y> <!-- Координата Y -->
                  </loc>
                </li>              
                <li> <!-- Элемент списка -->
                  <loc> <!-- Локация / источник позиционирования звука -->
                    <x>32.786</x>                   <!-- Координата X -->
                    <y>7168.717</y> <!-- Координата Y -->
                  </loc>
                </li>              
                <li> <!-- Элемент списка -->
                  <loc> <!-- Локация / источник позиционирования звука -->
                    <x>45.91975</x>                   <!-- Координата X -->
                    <y>4270.358</y> <!-- Координата Y -->
                  </loc>
                </li>              
                <li> <!-- Элемент списка -->
                  <loc> <!-- Локация / источник позиционирования звука -->
                    <x>66.10088</x>                   <!-- Координата X -->
                    <y>2557.69</y> <!-- Координата Y -->
                  </loc>
                </li>
              </points>
            </curve>
          </li>
        </paramMappings>      
        <filters> <!-- Список фильтров материалов -->
          <li Class="SoundFilterLowPass"> <!-- Элемент списка -->
            <cutoffFrequency>10000</cutoffFrequency>           <!-- Частота среза низкочастотного фильтра -->
            <lowpassResonaceQ>1</lowpassResonaceQ> <!-- Резонанс низкочастотного фильтра -->
          </li>
        </filters>      
        <sustainLoop>False</sustainLoop> <!-- Параметры цикла непрерывного звука -->
      </li>
    </subSounds>
  </SoundDef>
  
